#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>


#define BASE    0
#define CMAK    1
#define NAV     2
#define MOUSE   3
#define MEDIA   4
#define NUM     5
#define SYM     6
#define FN      7
#define VANILLA 8
#define SYS     9
#define SCROLL  10
#define SNIPE   11
#define XXX     &none
#define ___     &trans

&lt {
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX            XXX             XXX              XXX
XXX             &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I          &kp O           &kp SQT          XXX
XXX             &hm LGUI A      &hm LALT S      &hm LCTRL D     &hm LSHFT F     &kp G           &kp H           &hm RSHFT J     &hm RCTRL K    &hm LALT L      &hm RGUI P       XXX
XXX             &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA      &kp DOT         &kp FSLH         XXX
                                                &lt FN ESC      &lt NUM SPACE   &lt SYM TAB     &lt NAV BSPC    &lt MEDIA DEL
                                                &mkp LCLK       &mkp RCLK                       &lt MOUSE RET
            >;
        };

        cmak {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             &kp Q           &kp W           &kp F           &kp P           &kp B           &kp J           &kp L           &kp U           &kp Y           &kp SQT         XXX
XXX             &hm LGUI A      &hm LALT R      &hm LCTRL S     &hm LSHFT T     &kp G           &kp M           &hm RSHFT N     &hm RCTRL E     &hm LALT I      &hm RGUI O      XXX
XXX             &kp Z           &kp X           &kp C           &kp D           &kp V           &kp K           &kp H           &kp COMMA       &kp DOT         &kp FSLH        XXX
                                                &lt FN ESC      &lt NUM SPACE   &lt SYM TAB     &lt NAV BSPC    &lt MEDIA DEL
                                                &mkp LCLK       &mkp RCLK                       &lt MOUSE RET
            >;
        };

        nav {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             &kp PG_UP       &kp HOME        &kp UP          &kp END         &kp BSPC        &kp INS         XXX             XXX             XXX             XXX             XXX
XXX             &kp PG_DN       &kp LEFT        &kp DOWN        &kp RIGHT       &kp DEL         &kp CAPS        &kp RSHFT       &kp RCTRL       &kp LALT        &kp RGUI        XXX
XXX             &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LC(Y)       XXX             XXX             XXX             XXX             XXX             XXX
                                                ___             ___             ___             ___             ___
                                                ___             ___                             ___
            >;
        };

        mouse {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             &mo SCROLL      &mkp MCLK       &mkp LCLK       &mkp RCLK       XXX             XXX             &kp RSHFT       &kp RCTRL       &kp LALT        &kp RGUI        XXX
XXX             &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LC(Y)       XXX             XXX             XXX             XXX             XXX             XXX
                                                &mkp MCLK       &mkp LCLK       &mkp RCLK       ___             ___
                                                ___             ___                             ___
            >;
        };

        media {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             XXX             XXX             &kp C_VOL_UP    XXX             XXX             &sys_reset      XXX             XXX             XXX             XXX             XXX
XXX             XXX             &kp C_PREV      &kp C_VOL_DN    &kp C_NEXT      XXX             &bootloader     &kp RSHFT       &kp RCTRL       &kp LALT        &kp RGUI        XXX
XXX             XXX             XXX             XXX             XXX             XXX             &ext_power EP_OFF  XXX          XXX             XXX             XXX             XXX
                                                &lt SYS C_MUTE  &kp C_PP        &kp C_STOP      ___             ___
                                                ___             ___                             ___
            >;
        };

        num {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             &mo SCROLL      &mkp MCLK       &mkp LCLK       &mkp RCLK       XXX             &kp LBKT        &kp N7          &kp N8          &kp N9          &kp RBKT        XXX
XXX             &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT       XXX             &kp EQUAL       &kp N4          &kp N5          &kp N6          &kp SEMI        XXX
XXX             &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LC(Y)       &kp BSLH        &kp N1          &kp N2          &kp N3          &kp GRAVE       XXX
                                                ___             ___             ___             &kp N0          &kp DOT
                                                ___             ___                             &kp MINUS
            >;
        };

        sym {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             XXX             XXX             XXX             XXX             XXX             &kp LBRC        &kp AMPS        &kp ASTRK       &kp LPAR        &kp RBRC        XXX
XXX             &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT       XXX             &kp PLUS        &kp DLLR        &kp PRCNT       &kp CARET       &kp COLON       XXX
XXX             XXX             XXX             &kp LG(SPACE)   &kp LC(SPACE)   &kp LA(Z)       &kp PIPE        &kp EXCL        &kp AT          &kp HASH        &kp TILDE       XXX
                                                ___             ___             ___             &kp LPAR        &kp RPAR
                                                ___             ___                             &kp UNDER
            >;
        };

        fn {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             XXX             XXX             XXX             XXX             &sys_reset      &kp PSCRN       &kp F7          &kp F8          &kp F9          &kp F12         XXX
XXX             &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT       &bootloader     &kp SLCK        &kp F4          &kp F5          &kp F6          &kp F11         XXX
XXX             XXX             XXX             XXX             XXX       &ext_power EP_OFF   &kp PAUSE_BREAK   &kp F1          &kp F2          &kp F3          &kp F10         XXX
                                                ___             ___             ___             &kp SPACE       &lt SYS K_APP
                                                ___             ___                             &kp TAB
            >;
        };

        vanilla {
            bindings = <
&kp TILDE       &kp 1           &kp 2           &kp 3           &kp 4           &kp 5           &kp 6           &kp 7           &kp 8           &kp 9           &kp 0           &kp BSPC
&kp LSHFT       &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp SQT         XXX
&kp LALT        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &hm RSHIFT J    &hm LCTRL K     &hm LALT L      &hm LGUI P      XXX
&kp LCTRL       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        XXX
                                                &lt FN ESC      &kp SPACE       &kp TAB         &kp BSPC        &lt SYS DEL
                                                ___             ___                             &kp RET
            >;
        };

        sys {
            bindings = <
XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &to 0           &to 1           &to 8           XXX             XXX             XXX
XXX             &bt BT_CLR_ALL  XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
XXX             &bt BT_CLR      &out OUT_BLE    &out OUT_USB    XXX             XXX             XXX             XXX             XXX             XXX             XXX             XXX
                                                XXX             XXX             XXX             XXX             XXX
                                                XXX             XXX                             XXX
            >;
        };

        scroll {
            bindings = <
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
                                                ___             ___             ___             ___             ___
                                                ___             ___                             ___
            >;
        };

        snipe {
            bindings = <
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
___             ___             &mkp MCLK       &mkp LCLK       &mkp RCLK       ___             ___             ___             ___             ___             ___             ___
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___             ___
                                                ___             ___             ___             ___             ___
                                                ___             ___                             ___
            >;
        };
    };
};
